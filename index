        let currentSlide = 0;
        let showNotes = true;

        function renderSlide(index) {
            const container = document.getElementById('slidesContainer');
            const slide = slides[index];

            let html = `
                <div class="slide-container">
                    <h2 class="slide-title">${slide.title}</h2>
                    <div class="slide-body">${slide.body}</div>
                    ${slide.notes ? `<div class="speaker-notes ${showNotes ? 'visible' : ''}">
                        <h4>Speaker Notes</h4>
                        <p>${slide.notes}</p>
                    </div>` : ''}
                </div>
            `;

            container.innerHTML = html;
            updateNavigation();
            updateProgress();
        }

        function updateNavigation() {
            document.getElementById('prevBtn').disabled = currentSlide === 0;
            document.getElementById('nextBtn').disabled = currentSlide === slides.length - 1;
            document.getElementById('slideNumber').textContent = currentSlide + 1;
            document.getElementById('totalSlides').textContent = slides.length;
            document.getElementById('progressText').textContent = `Slide ${currentSlide + 1} of ${slides.length}`;
        }

        function updateProgress() {
            const progress = ((currentSlide + 1) / slides.length) * 100;
            document.getElementById('progressFill').style.width = progress + '%';
        }

        function nextSlide() {
            if (currentSlide < slides.length - 1) {
                currentSlide++;
                renderSlide(currentSlide);
                window.scrollTo(0, 0);
            }
        }

        function previousSlide() {
            if (currentSlide > 0) {
                currentSlide--;
                renderSlide(currentSlide);
                window.scrollTo(0, 0);
            }
        }

        document.getElementById('toggleNotes').addEventListener('click', function() {
            showNotes = !showNotes;
            const notes = document.querySelectorAll('.speaker-notes');
            notes.forEach(note => {
                if (showNotes) {
                    note.classList.add('visible');
                } else {
                    note.classList.remove('visible');
                }
            });
            this.classList.toggle('active');
        });

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowRight') nextSlide();
            if (e.key === 'ArrowLeft') previousSlide();
        });

        // Initialize
        renderSlide(0);
    </script>
